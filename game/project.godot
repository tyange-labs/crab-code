; Godot 프로젝트 설정. 에디터에서 바꾸면 이 파일이 다시 써진다.

config_version=5

[application]

config/name="Crab Code"
config/description="꽃게 페리스를 Rust 코드로 움직이며 Rust 를 배우는 퍼즐"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1360
window/size/viewport_height=860
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0824, 0.0902, 0.1333, 1)

[autoload]

Sfx="*res://scripts/sfx.gd"
