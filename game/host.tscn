[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/host.gd" id="1_host"]
[ext_resource type="Script" path="res://scripts/logo.gd" id="2_logo"]
[ext_resource type="Script" path="res://scripts/markdown_view.gd" id="3_md"]

[node name="Host" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_host")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
