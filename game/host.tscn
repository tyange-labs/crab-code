[node name="Next" type="Button" parent="Margin/Root/Body/Right/WorldPanel/VBox/Banner/HBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
focus_mode = 0
text = "다음 레벨"

[node name="ConsolePanel" type="PanelContainer" parent="Margin/Root/Body/Right"]
layout_mode = 2
size_flags_vertical = 3

[node name="VBox" type="VBoxContainer" parent="Margin/Root/Body/Right/ConsolePanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ConsoleLabel" type="Label" parent="Margin/Root/Body/Right/ConsolePanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
