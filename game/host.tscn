[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/host.gd" id="1_host"]
[ext_resource type="Script" path="res://scripts/logo.gd" id="2_logo"]
[ext_resource type="Script" path="res://scripts/markdown_view.gd" id="3_md"]

[node name="Host" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_host")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 14

[node name="Root" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Logo" type="Control" parent="Margin/Root/Header"]
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
script = ExtResource("2_logo")

[node name="Brand" type="VBoxContainer" parent="Margin/Root/Header"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="BrandName" type="Label" parent="Margin/Root/Header/Brand"]
unique_name_in_owner = true
layout_mode = 2
text = "Crab Code"

[node name="BrandSub" type="Label" parent="Margin/Root/Header/Brand"]
unique_name_in_owner = true
layout_mode = 2
text = "IDE 로 짜는 게임"

[node name="PackPicker" type="OptionButton" parent="Margin/Root/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
tooltip_text = "게임팩 바꾸기"

[node name="Spacer" type="Control" parent="Margin/Root/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Progress" type="Label" parent="Margin/Root/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4

[node name="ChapterPicker" type="OptionButton" parent="Margin/Root/Header"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
tooltip_text = "장 고르기"

[node name="Levels" type="HBoxContainer" parent="Margin/Root/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 5

[node name="Sound" type="Button" parent="Margin/Root/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
text = "소리 켜짐"

[node name="Body" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="Left" type="VBoxContainer" parent="Margin/Root/Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.8
theme_override_constants/separation = 10

[node name="LessonPanel" type="PanelContainer" parent="Margin/Root/Body/Left"]
layout_mode = 2
size_flags_vertical = 3

[node name="VBox" type="VBoxContainer" parent="Margin/Root/Body/Left/LessonPanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ChapterName" type="Label" parent="Margin/Root/Body/Left/LessonPanel/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="LessonTitle" type="Label" parent="Margin/Root/Body/Left/LessonPanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="LessonScroll" type="ScrollContainer" parent="Margin/Root/Body/Left/LessonPanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="LessonBody" type="Control" parent="Margin/Root/Body/Left/LessonPanel/VBox/LessonScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
script = ExtResource("3_md")

[node name="WorkspacePanel" type="PanelContainer" parent="Margin/Root/Body/Left"]
unique_name_in_owner = true
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Margin/Root/Body/Left/WorkspacePanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="FileTitle" type="Label" parent="Margin/Root/Body/Left/WorkspacePanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "지금 고칠 파일"

[node name="FileName" type="Label" parent="Margin/Root/Body/Left/WorkspacePanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text_overrun_behavior = 3

[node name="FilePath" type="Label" parent="Margin/Root/Body/Left/WorkspacePanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text_overrun_behavior = 3

[node name="OpenRow" type="HBoxContainer" parent="Margin/Root/Body/Left/WorkspacePanel/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="OpenIde" type="Button" parent="Margin/Root/Body/Left/WorkspacePanel/VBox/OpenRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "IDE 로 열기"

[node name="OpenFolder" type="Button" parent="Margin/Root/Body/Left/WorkspacePanel/VBox/OpenRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "폴더 열기"

[node name="CopyCommand" type="Button" parent="Margin/Root/Body/Left/WorkspacePanel/VBox/OpenRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "터미널에서 직접 돌려 볼 명령을 복사해요"
text = "cargo run 복사"

[node name="WatchStatus" type="Label" parent="Margin/Root/Body/Left/WorkspacePanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="GitStatus" type="Label" parent="Margin/Root/Body/Left/WorkspacePanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text_overrun_behavior = 3

[node name="Buttons" type="HBoxContainer" parent="Margin/Root/Body/Left"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Run" type="Button" parent="Margin/Root/Body/Left/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 40)
layout_mode = 2
focus_mode = 0
text = "실행 (F5)"

[node name="Hint" type="Button" parent="Margin/Root/Body/Left/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "힌트"

[node name="Solution" type="Button" parent="Margin/Root/Body/Left/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "정답 보기"

[node name="Reset" type="Button" parent="Margin/Root/Body/Left/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "파일을 처음 코드로 되돌려요. 지금 코드는 git 에 커밋해 둬요."
text = "처음 코드로"

[node name="Right" type="VBoxContainer" parent="Margin/Root/Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.2
theme_override_constants/separation = 10

[node name="WorldPanel" type="PanelContainer" parent="Margin/Root/Body/Right"]
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 2.4

[node name="VBox" type="VBoxContainer" parent="Margin/Root/Body/Right/WorldPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ViewHost" type="Control" parent="Margin/Root/Body/Right/WorldPanel/VBox"]
unique_name_in_owner = true
clip_contents = true
layout_mode = 2
size_flags_vertical = 3

[node name="Timeline" type="HBoxContainer" parent="Margin/Root/Body/Right/WorldPanel/VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Back" type="Button" parent="Margin/Root/Body/Right/WorldPanel/VBox/Timeline"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 32)
layout_mode = 2
focus_mode = 0
tooltip_text = "한 틱 뒤로"
text = "◀"

[node name="Play" type="Button" parent="Margin/Root/Body/Right/WorldPanel/VBox/Timeline"]
unique_name_in_owner = true
custom_minimum_size = Vector2(72, 32)
layout_mode = 2
focus_mode = 0
text = "재생"

[node name="Forward" type="Button" parent="Margin/Root/Body/Right/WorldPanel/VBox/Timeline"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 32)
layout_mode = 2
focus_mode = 0
tooltip_text = "한 틱 앞으로"
text = "▶"

[node name="Slider" type="HSlider" parent="Margin/Root/Body/Right/WorldPanel/VBox/Timeline"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_mode = 0
step = 0.0

[node name="TickLabel" type="Label" parent="Margin/Root/Body/Right/WorldPanel/VBox/Timeline"]
unique_name_in_owner = true
custom_minimum_size = Vector2(76, 0)
layout_mode = 2
horizontal_alignment = 2

[node name="Speed" type="Button" parent="Margin/Root/Body/Right/WorldPanel/VBox/Timeline"]
unique_name_in_owner = true
custom_minimum_size = Vector2(56, 32)
layout_mode = 2
focus_mode = 0
text = "1x"

[node name="Inspector" type="PanelContainer" parent="Margin/Root/Body/Right/WorldPanel/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="InspectorText" type="RichTextLabel" parent="Margin/Root/Body/Right/WorldPanel/VBox/Inspector"]
unique_name_in_owner = true
layout_mode = 2
bbcode_enabled = true
fit_content = true
selection_enabled = true

[node name="Banner" type="PanelContainer" parent="Margin/Root/Body/Right/WorldPanel/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="HBox" type="HBoxContainer" parent="Margin/Root/Body/Right/WorldPanel/VBox/Banner"]
layout_mode = 2

[node name="BannerText" type="Control" parent="Margin/Root/Body/Right/WorldPanel/VBox/Banner/HBox"]
